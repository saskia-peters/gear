# -----------------------------------------------------------------------------
# G.E.A.R. environment configuration surface (Story 1.1)
#
# The server reads these at startup (internal/platform/config). Defaults match
# local development (justfile + compose.yaml); override per environment.
# Copy to .env (gitignored) or export in your shell. NEVER commit real values.
# -----------------------------------------------------------------------------

# PostgreSQL DSN for the pgx connection pool (shared with the golang-migrate
# CLI via the justfile's DATABASE_URL default).
GEAR_DATABASE_URL=postgres://gear:gear@localhost:5432/gear?sslmode=disable

# HTTP listen address of the API server.
GEAR_HTTP_ADDR=:8080

# Log level: debug | info | warn | error.
GEAR_LOG_LEVEL=info

# Server-side session idle lifetime (NFR-S2). Defaults to 8h.
GEAR_SESSION_IDLE=8h

# Public origin of the SPA, used to build clickable password-reset links
# (review finding 1.8-6). Defaults to the Vite dev server.
GEAR_APP_ORIGIN=http://localhost:5173

# App-level 32-byte key for at-rest encryption of TOTP secrets (NFR-S4).
# Hex or base64 encoded; exactly 32 decoded bytes. MFA operations return
# "MFA ist derzeit nicht verfügbar." (503) when it is missing/invalid.
# Generate one with:  openssl rand -hex 32   (or  openssl rand -base64 32)
GEAR_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Admin bootstrap secrets — FUTURE STORIES (bootstrap 1.4+). Placeholders only;
# fill at deploy time from a secret manager. No real secrets may be committed.
# -----------------------------------------------------------------------------
#GEAR_ADMIN_1_EMAIL=admin.1@gear.local
#GEAR_ADMIN_1_PASSWORD=
#GEAR_ADMIN_2_EMAIL=admin.2@gear.local
#GEAR_ADMIN_2_PASSWORD=
