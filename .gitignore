# BMad generated artifacts
.agent/
skills/reports/

# BMad personal overrides (gitignored by design, see _bmad/custom/.gitignore)

# --- Go ---
bin/
*.test
# Bare Go build outputs (e.g. `go build ./cmd/...`)
/devadmin
/server
/cmd/server/server

# --- Node / Vite SPA (web/) ---
web/node_modules/
web/dist/

# --- local environment overrides ---
# .env.example is the documented config surface and must stay tracked.
.env
.env.*
!.env.example

# --- Docs: build-time generated pages (regenerated by docs/scripts/generate-docs.js) ---
docs/docs/epics/
docs/docs/status.md
docs/docs/screenshots.md
docs/src/data/screenshots.json
docs/build/
docs/.docusaurus/
docs/test-results/
